# 1. Hugo 自动生成的构建产物 (最关键)
/public/
/resources/_gen/
.hugo_build.lock

# 2. 操作系统自动生成的缓存文件
.DS_Store
.DS_Store?
.AppleDouble
.Spotlight-V100
.LSOverride
.Trashes
._*
Thumbs.db
ehthumbs.db

# 3. 编辑器/IDE 的临时文件 (专门为你加了 Neovim 相关的后缀)
*.swp
*.swo
*~
.vscode/
.idea/

# 4. 依赖包 (如果你未来给主题加了 Node.js 相关的构建工具)
node_modules/
package-lock.json
yarn.lock

# backup
*.bak

